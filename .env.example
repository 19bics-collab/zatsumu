# docker compose 用の設定。このファイルを .env にコピーして書き換える
#   cp .env.example .env

# 勤怠管理を公開するドメイン名 (DNS の A レコードをこのサーバの IP に向けておくこと)
ZATSUMU_DOMAIN=kintai.example.com

# メール対応を公開するドメイン名 (勤怠とは別UI・同じサーバ/DB)。
# こちらも A レコードを同じ IP に向ける
ZATSUMU_MAIL_DOMAIN=mail.example.com

# スクリーンショットの保存日数 (これより古いものは自動削除)
ZATSUMU_RETENTION_DAYS=30
