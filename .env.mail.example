# メール対応「だけ」を動かすサーバ用の設定。このファイルを .env にコピーして書き換える
#   cp .env.mail.example .env

# この設定ファイルを使う（勤怠とメールの2つを出す既定の Caddyfile ではなく、メール専用）
ZATSUMU_CADDYFILE=Caddyfile.mail

# メール画面を公開する住所 (DNS の A レコードをこのサーバの IP に向けておくこと)
# ⚠️ mail.<会社のドメイン> は会社のメールで使われていることが多いので避ける
ZATSUMU_MAIL_DOMAIN=inbox.example.com

# 新しい端末からの管理者ログインに、メールの確認コードを必須にする (任意・おすすめ)
# 確認コードの送り先を書くと有効。空のままなら無効 (合言葉だけでログインできる)
# 先にメール画面の「設定 → 返信の送信(SMTP)」でメールを送れるようにしておくこと。
# 更新後は必ず docker compose up -d --force-recreate caddy で Caddy を作り直すこと
# (作り直さないと /api/device が 404 になり、確認コードの画面から進めない。DEPLOY.md)
# メールが届かずにログインできないときは、サーバで
#   docker compose exec app python manage.py issue-device <管理者の名前>
# を実行し、表示された #device=... をメール画面のアドレスの後ろに付けて開く (DEPLOY.md)
ZATSUMU_LOGIN_VERIFY_EMAIL=

# ─── m2m清掃管理 → ヤドツギ 読み取り係 (任意。使うときだけ。m2m_sync/README.md) ───
# 下の1行で docker-compose.m2m.yml も一緒に動くようになる
# COMPOSE_FILE=docker-compose.yml:docker-compose.m2m.yml
# m2m のログイン情報 (2段階認証なしのアカウント)
M2M_EMAIL=
M2M_PASSWORD=
# ヤドツギの受け取り窓口
M2M_INGEST_URL=https://<ヤドツギのドメイン>/api/internal/m2m/cleanings
# 合言葉 (32文字以上)。ヤドツギ側 .env の M2M_INGEST_KEY と同じ値。openssl rand -hex 32 で作る
M2M_INGEST_KEY=
# 実行時刻 (日本時間・カンマ区切りで複数可)
M2M_RUN_AT=06:00
# true にするとヤドツギは DB を変えずに結果だけ返す (試運転)
M2M_DRY_RUN=true
